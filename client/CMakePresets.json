{
    "version": 6,
    "configurePresets": [
        {
            "name": "linux-base",
            "hidden": true,
            "generator": "Ninja",
            "binaryDir": "${sourceDir}/build/${presetName}",
            "condition": {
                "type": "equals",
                "lhs": "${hostSystemName}",
                "rhs": "Linux"
            },
            "cacheVariables": {
                "CMAKE_INSTALL_PREFIX": "${sourceDir}/install/${presetName}"
            }
        },
        {
            "name": "linux-debug",
            "displayName": "Linux Debug (system Qt6)",
            "inherits": "linux-base",
            "cacheVariables": {
                "CMAKE_BUILD_TYPE": "Debug"
            }
        },
        {
            "name": "linux-release",
            "displayName": "Linux Release (system Qt6)",
            "inherits": "linux-base",
            "cacheVariables": {
                "CMAKE_BUILD_TYPE": "Release"
            }
        },
        {
            "name": "windows-msvc-base",
            "hidden": true,
            "generator": "Ninja Multi-Config",
            "binaryDir": "${sourceDir}/build/${presetName}",
            "toolchainFile": "$env{VCPKG_ROOT}/scripts/buildsystems/vcpkg.cmake",
            "condition": {
                "type": "equals",
                "lhs": "${hostSystemName}",
                "rhs": "Windows"
            },
            "cacheVariables": {
                "CMAKE_INSTALL_PREFIX": "${sourceDir}/install/${presetName}",
                "CMAKE_C_COMPILER": "cl.exe",
                "CMAKE_CXX_COMPILER": "cl.exe"
            },
            "environment": {
                "_comment": "Ninja не находит cl.exe сам — либо запускайте из Developer Command Prompt, либо пропишите здесь PATH/INCLUDE/LIB из vcvarsall.bat"
            }
        },
        {
            "name": "windows-msvc",
            "displayName": "Windows (Ninja Multi-Config, MSVC amd64)",
            "description": "Multi-config MSVC build via Ninja; Debug/Release chosen at build time. CMAKE_PREFIX_PATH (Qt) задаётся в CMakeUserPresets.json",
            "inherits": "windows-msvc-base"
        },
        {
            "name": "android-base",
            "hidden": true,
            "description": "Требует QT_ROOT_DIR (Android-сборка Qt под нужный ABI), QT_HOST_PATH (desktop-сборка Qt для moc/androiddeployqt) и ANDROID_NDK_ROOT в окружении",
            "generator": "Ninja",
            "binaryDir": "${sourceDir}/build/${presetName}",
            "toolchainFile": "$env{QT_ROOT_DIR}/lib/cmake/Qt6/qt.toolchain.cmake",
            "cacheVariables": {
                "CMAKE_INSTALL_PREFIX": "${sourceDir}/install/${presetName}",
                "CMAKE_BUILD_TYPE": "Debug",
                "QT_HOST_PATH": "$env{QT_HOST_PATH}",
                "ANDROID_NDK_ROOT": "$env{ANDROID_NDK_ROOT}",
                "ANDROID_PLATFORM": "android-24",
                "ANDROID_STL": "c++_shared",
                "QT_ANDROID_BUILD_ALL_ABIS": "OFF"
            }
        },
        {
            "name": "android",
            "displayName": "Android (arm64-v8a, устройство)",
            "inherits": "android-base",
            "cacheVariables": {
                "ANDROID_ABI": "arm64-v8a"
            }
        },
        {
            "name": "android-x86_64",
            "displayName": "Android (x86_64, эмулятор)",
            "inherits": "android-base",
            "cacheVariables": {
                "ANDROID_ABI": "x86_64"
            }
        }
    ],
    "buildPresets": [
        {
            "name": "linux-debug",
            "configurePreset": "linux-debug"
        },
        {
            "name": "linux-release",
            "configurePreset": "linux-release"
        },
        {
            "name": "windows-msvc-debug",
            "displayName": "Windows amd64 - Debug",
            "configurePreset": "windows-msvc",
            "configuration": "Debug"
        },
        {
            "name": "windows-msvc-release",
            "displayName": "Windows amd64 - Release",
            "configurePreset": "windows-msvc",
            "configuration": "Release"
        },
        {
            "name": "android-apk",
            "displayName": "Android Debug APK (устройство, arm64-v8a)",
            "configurePreset": "android",
            "targets": [ "apk" ]
        },
        {
            "name": "android-x86_64-apk",
            "displayName": "Android Debug APK (эмулятор, x86_64)",
            "configurePreset": "android-x86_64",
            "targets": [ "apk" ]
        }
    ]
}
